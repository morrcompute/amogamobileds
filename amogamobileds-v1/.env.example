# =============================================================================
# Amoga Mobile Design System - Environment Variables (.env.local)
# =============================================================================

# --- Supabase Database & Auth ---
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# --- AI SDK & Multi-Model Providers ---
# 🌟 RECOMMENDED: 1 Single Key for ALL Models (Gemini, GPT-4o, Claude 3.5, DeepSeek, Llama 3.3)
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=
EXPO_PUBLIC_OPENROUTER_API_KEY=

# --- Individual Direct Provider Keys (Optional) ---
# Google Gemini (Free tier available! Get from: https://aistudio.google.com/app/apikey)
GOOGLE_GENERATIVE_AI_API_KEY=
EXPO_PUBLIC_GEMINI_API_KEY=

# OpenAI (Get from: https://platform.openai.com/api-keys)
OPENAI_API_KEY=
EXPO_PUBLIC_OPENAI_API_KEY=

# Anthropic Claude (Get from: https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=
EXPO_PUBLIC_ANTHROPIC_API_KEY=

# Groq / Fast Llama 3.3 (Get from: https://console.groq.com/keys)
GROQ_API_KEY=
EXPO_PUBLIC_GROQ_API_KEY=

# DeepSeek (Get from: https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=
EXPO_PUBLIC_DEEPSEEK_API_KEY=

# Web Search Grounding Tool (Get from: https://tavily.com)
TAVILY_API_KEY=
EXPO_PUBLIC_TAVILY_API_KEY=
